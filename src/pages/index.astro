---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

import serviceWebdesign from '../assets/images/service-webdesign.png';
import serviceSeo from '../assets/images/service-seo.png';
import serviceWordpress from '../assets/images/service-wordpress.png';
import robert from '../assets/images/robert-home.png';

import logoVeritec from '../assets/images/clients/veritec.png';
import logoAdlerblick from '../assets/images/clients/adlerblick.png';
import logoPodologie from '../assets/images/clients/podologie.png';
import logoLifestyyler from '../assets/images/clients/lifestyyler.png';
import logoPhysio from '../assets/images/clients/physiotherapie.png';
import logoBuergel from '../assets/images/clients/dr-buergel.png';
import logo99 from '../assets/images/clients/99blickwinkel.png';

const clients = [
  { src: logoVeritec, alt: 'Veritec Solution GmbH' },
  { src: logoAdlerblick, alt: 'Adlerblick' },
  { src: logoPhysio, alt: 'Physiotherapie Suppik' },
  { src: logoBuergel, alt: 'Hausarzt Dr. Bürgel' },
  { src: logo99, alt: '99blickwinkel' },
  { src: logoPodologie, alt: 'Podologie Kolb' },
  { src: logoLifestyyler, alt: 'Lifestyyler' },
];

const services = [
  {
    img: serviceWebdesign,
    title: 'Webdesign',
    text: 'Moderne, pixelperfekte Webseiten – für alle Endgeräte optimiert und so gebaut, dass aus Besuchern Kunden werden.',
    href: '/leistungen/webdesign/',
  },
  {
    img: serviceSeo,
    title: 'SEO',
    text: 'Suchmaschinenoptimierung mit über 11 Jahren Erfahrung. Werden Sie bei Google sichtbar und erreichen Sie Ihre Zielgruppe.',
    href: '/leistungen/seo/',
  },
  {
    img: serviceWordpress,
    title: 'WordPress',
    text: 'Das beste CMS der Welt – professionell umgesetzt. Wir sind auf WordPress und Elementor spezialisiert.',
    href: '/leistungen/wordpress-agentur/',
  },
];

const advantages = [
  { k: 'Respektvolle Zusammenarbeit', v: 'Aus Projekten werden Partnerschaften. Wir betreuen Kunden über Jahre – ehrlich und auf Augenhöhe.' },
  { k: 'Optimiertes Webdesign', v: 'Jede Seite wird responsive, DSGVO-konform und mit SEO-Standards umgesetzt – ohne Aufpreis.' },
  { k: '11 Jahre SEO-Expertise', v: 'Seit 2010 in der Suchmaschinenoptimierung. Wir wissen, wie man dauerhaft sichtbar wird.' },
  { k: 'Festpreis-Angebote', v: 'Nach einem kostenlosen Erstgespräch bekommen Sie ein klares Angebot zum Fixpreis – keine bösen Überraschungen.' },
];

const faqs = [
  {
    q: 'Wie läuft die Erstellung einer Webseite ab?',
    a: 'Wir starten mit einem kostenlosen Erstgespräch und einer Analyse Ihrer Ziele. Danach folgt unser bewährter 4-Schritte-Prozess: Erstgespräch, Teilentwurf, Entwicklung und Go-live. Alle Details finden Sie auf unserer Webdesign-Seite.',
  },
  {
    q: 'Wie viel kostet ein individuelles Webdesign?',
    a: 'Das hängt vom Umfang ab. Unsere Webdesign-Pakete starten bei 1.899 € für eine kompakte Unternehmensseite. Onlineshops beginnen bei 4.999 €. Sie erhalten nach dem Erstgespräch immer ein transparentes Festpreis-Angebot.',
  },
  {
    q: 'Bietet CodeRocker wirklich Festpreis-Angebote?',
    a: 'Ja. Nach dem kostenlosen Erstgespräch und der Klärung Ihrer Anforderungen erhalten Sie ein verbindliches Angebot zum Fixpreis. So wissen Sie von Anfang an, woran Sie sind.',
  },
  {
    q: 'Kann man durch SEO neue Kunden gewinnen?',
    a: 'Durch eine gezielte Suchmaschinenoptimierung kann man definitiv neue Kunden gewinnen! Besonders für lokale Dienstleister ist SEO einer der wirkungsvollsten Kanäle. Auf Wunsch betreuen wir Ihre Rankings laufend.',
  },
];
---

<BaseLayout
  title="Webdesign & Online Marketing das rockt 🚀 » CodeRocker"
  description="Erreichen Sie mehr Kunden durch gezieltes Online Marketing ✔️ Webdesign ✔️ SEO ✔️ Online-Shop. Ihre Agentur aus Hallein bei Salzburg – 11 Jahre Erfahrung."
  path="/"
  heroDark={true}
>
  <!-- HERO -->
  <section class="hero section--ink">
    <canvas class="hero-canvas" data-particles aria-hidden="true"></canvas>
    <div class="container hero-inner">
      <p class="eyebrow float">// webdesign · seo · online marketing</p>
      <h1 class="hero-title">
        <span class="line">
          <span class="reveal-word" style="animation-delay:.05s">Webdesign</span>
          <span class="reveal-word" style="animation-delay:.12s">und</span>
          <span class="reveal-word" style="animation-delay:.19s">Online</span>
          <span class="reveal-word" style="animation-delay:.26s">Marketing,</span>
        </span>
        <span class="line">
          <span class="reveal-word" style="animation-delay:.36s">das</span>
          <span class="reveal-word shimmer" style="animation-delay:.46s">rockt!</span>
        </span>
      </h1>
      <p class="lead hero-lead">
        Wir bauen Webseiten, die nicht nur gut aussehen, sondern messbar mehr Kunden bringen.
        Optimiert für Google, schnell, sicher – und mit über 11&nbsp;Jahren Erfahrung umgesetzt.
      </p>
      <div class="hero-cta">
        <a href="/kontakt/" class="btn btn--grad" data-magnetic>Kostenloses Erstgespräch <span class="arrow">→</span></a>
        <a href="/referenzen/" class="btn btn--ghost" data-magnetic>Referenzen ansehen</a>
      </div>
      <div class="hero-meta">
        <span class="stars">★★★★★</span>
        <span>{site.rating} / 5,0 &nbsp;·&nbsp; Inhaber {site.owner} &nbsp;·&nbsp; Hallein bei Salzburg</span>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true"><span></span>scroll</div>
  </section>

  <!-- STATS -->
  <section class="section stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat" data-reveal>
          <div class="stat-num"><span data-count="11">0</span><i>+</i></div>
          <p>Jahre Erfahrung</p>
        </div>
        <div class="stat" data-reveal>
          <div class="stat-num"><span data-count="12">0</span><i>+</i></div>
          <p>umgesetzte Projekte</p>
        </div>
        <div class="stat" data-reveal>
          <div class="stat-num"><span data-count="5">0</span><i>,0★</i></div>
          <p>Kundenbewertung</p>
        </div>
        <div class="stat" data-reveal>
          <div class="stat-num">DACH</div>
          <p>Salzburg · Bayern · remote</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENT LOGOS (Marquee) -->
  <section class="section logos-section">
    <div class="container">
      <p class="logos-label">Vertrauen von Unternehmen aus der gesamten DACH-Region</p>
    </div>
    <div class="marquee">
      <div class="marquee__track">
        {[...clients, ...clients].map((c) => (
          <Image src={c.src} alt={c.alt} height={44} class="client-logo" loading="eager" />
        ))}
      </div>
    </div>
  </section>

  <!-- KINETIC TYPE -->
  <div class="kinetic" aria-hidden="true">
    <div class="kinetic__track">
      {Array.from({ length: 2 }).map(() => (
        <>
          <span class="fill">Webdesign</span><span class="dot">✦</span>
          <span>SEO</span><span class="dot">✦</span>
          <span class="fill">WordPress</span><span class="dot">✦</span>
          <span>Online Marketing</span><span class="dot">✦</span>
          <span class="fill">Consulting</span><span class="dot">✦</span>
        </>
      ))}
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section section--tint section--center">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// leistungen</p>
        <h2>Unsere Online-Marketing-Lösungen</h2>
        <p class="lead">Alles aus einer Hand – damit Ihr Auftritt im Web zusammenpasst und funktioniert.</p>
      </div>
      <div class="grid grid--3">
        {services.map((s) => (
          <a href={s.href} class="card service-card" data-reveal data-tilt>
            <div class="service-img">
              <Image src={s.img} alt={s.title} width={760} height={507} quality={86} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="card-link">Mehr erfahren <span class="arrow">→</span></span>
          </a>
        ))}
        <div class="card service-card service-card--more" data-reveal data-tilt>
          <h3>Weitere Leistungen</h3>
          <p>Individuelle Online-Marketing-Lösungen, Wartung &amp; Sicherheit, Schulungen und Consulting für Ihr Unternehmen.</p>
          <a href="/leistungen/" class="card-link">Alle Leistungen <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ADVANTAGES -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// warum coderocker</p>
        <h2>Ihre Vorteile auf einen Blick</h2>
      </div>
      <div class="grid grid--2 adv-grid">
        {advantages.map((a, i) => (
          <div class="adv-item" data-reveal>
            <span class="adv-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{a.k}</h3>
              <p>{a.v}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section section--ink">
    <div class="container founder">
      <div class="founder-photo" data-reveal>
        <Image src={robert} alt={`${site.owner}, Inhaber von CodeRocker`} width={620} height={745} quality={88} />
      </div>
      <div class="founder-text" data-reveal>
        <p class="eyebrow">// inhaber &amp; seo-consultant</p>
        <h2>Hallo, ich bin Robert.</h2>
        <p class="lead">
          Seit 2010 beschäftige ich mich mit Suchmaschinenoptimierung, 2017 habe ich CodeRocker
          gegründet. Mein Anspruch: Webseiten, die für Ihr Unternehmen arbeiten – technisch sauber,
          bei Google gut gefunden und mit einem Design, das im Kopf bleibt.
        </p>
        <p>
          Wir setzen Projekte in der gesamten DACH-Region um. Direkt vor Ort sind wir vor allem in
          Österreich (Region Salzburg) und Deutschland (Region Bayern) – sonst arbeiten wir remote.
        </p>
        <a href="/ueber-uns/" class="btn btn--ghost">Mehr über uns</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="section section--tint section--center">
    <div class="container testimonial">
      <p class="stars testimonial-stars">★★★★★</p>
      <blockquote>
        „Ich bin mit der Arbeit von Robert Leitinger von CodeRocker hochzufrieden. Die Praxis­homepage
        ist rundum gelungen. Die Arbeit ist hochprofessionell und kundenorientiert.“
      </blockquote>
      <cite>— Dr. Georg Bürgel, Hausarzt</cite>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <div class="section-head">
        <p class="eyebrow">// faq</p>
        <h2>Fragen, die oft gestellt werden</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--ink section--center cta-band">
    <div class="container">
      <h2>Bereit, online durchzustarten?</h2>
      <p class="lead">Erzählen Sie uns von Ihrem Projekt – das Erstgespräch ist kostenlos und unverbindlich.</p>
      <a href="/kontakt/" class="btn btn--grad" data-magnetic>Projekt starten <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero { padding-block: clamp(7rem, 16vw, 12rem) clamp(4rem, 9vw, 7rem); min-height: 100vh; display: flex; align-items: center; }
  .hero.section--ink { background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .hero.section--ink::before { display: none; }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; opacity: 0.6; }
  .hero .container { position: relative; z-index: 2; }
  .hero-inner { max-width: 64rem; }
  .hero-title {
    margin-bottom: 1.5rem;
    font-size: clamp(2.9rem, 8.5vw, 6.5rem);
    line-height: 0.98; letter-spacing: -0.035em;
    text-shadow: 0 8px 60px rgba(124, 70, 255, 0.35);
  }
  .hero-title .line { display: block; overflow: hidden; }
  .hero-title .reveal-word { margin-right: 0.26em; }
  .hero-lead { color: var(--ink-soft); margin-bottom: 2rem; }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.25rem; }
  .hero-meta {
    display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;
    font-size: 0.95rem; color: var(--ink-soft);
  }
  .hero-scroll {
    position: absolute; left: 50%; bottom: 1.6rem; transform: translateX(-50%);
    z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .hero-scroll span {
    width: 1px; height: 38px;
    background: linear-gradient(var(--magenta), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse { 0%,100% { opacity: 0.3; transform: scaleY(0.6); } 50% { opacity: 1; transform: scaleY(1); } }

  /* STATS */
  .stats-section { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .stat { text-align: center; padding: 1.5rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-glass); backdrop-filter: blur(6px); }
  .stat-num { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.2rem, 5vw, 3.2rem); line-height: 1; background: linear-gradient(120deg, #fff, #c4abff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stat-num i { font-style: normal; }
  .stat p { margin: 0.6rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
  @media (max-width: 720px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }

  /* LOGOS */
  .logos-section { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .logos-label { text-align: center; font-size: 0.82rem; letter-spacing: 0.05em; color: var(--ink-faint); margin-bottom: 1.75rem; font-family: var(--font-mono); }
  .logos-strip {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
  }
  .client-logo {
    height: 42px; width: auto;
    filter: brightness(0) invert(1); opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .client-logo:hover { opacity: 0.95; }

  /* SERVICES */
  .service-card { display: flex; flex-direction: column; color: var(--ink-2); text-decoration: none; padding: 1.25rem; }
  .service-card:hover { text-decoration: none; }
  .service-img { border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1.25rem; }
  .service-img :global(img) { width: 100%; height: auto; display: block; transition: transform 0.4s ease; }
  .service-card:hover .service-img :global(img) { transform: scale(1.04); }
  .service-card h3 { margin-bottom: 0.5rem; }
  .service-card p { font-size: 0.98rem; flex: 1; }
  .card-link { font-family: var(--font-display); font-weight: 600; color: #c4abff; }
  .service-card--more { background: var(--grad); color: #fff; border: 0; justify-content: center; }
  .service-card--more:hover { box-shadow: var(--shadow-brand); }
  .service-card--more h3 { color: #fff; }
  .service-card--more .card-link { color: #fff; }

  /* ADVANTAGES */
  .adv-grid { gap: 2rem 2.5rem; }
  .adv-item { display: flex; gap: 1.25rem; }
  .adv-num {
    font-family: var(--font-mono); font-size: 0.95rem; font-weight: 500;
    color: var(--brand);
    border: 1px solid var(--line); border-radius: 8px;
    padding: 0.3rem 0.55rem; height: max-content;
  }
  .adv-item h3 { margin-bottom: 0.35rem; }
  .adv-item p { font-size: 0.98rem; margin: 0; }

  /* FOUNDER */
  .founder { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .founder-photo :global(img) { width: 100%; height: auto; border-radius: var(--radius); }
  .founder-text .lead { color: #fff; }

  /* TESTIMONIAL */
  .testimonial { max-width: 48rem; margin-inline: auto; text-align: center; }
  .testimonial-stars { font-size: 1.4rem; margin-bottom: 1rem; }
  .testimonial blockquote {
    font-family: var(--font-display); font-size: clamp(1.3rem, 3vw, 1.9rem);
    line-height: 1.4; color: var(--ink); margin: 0 0 1.25rem;
  }
  .testimonial cite { color: var(--ink-soft); font-style: normal; font-weight: 500; }

  /* FAQ */
  .faq-wrap { max-width: 52rem; margin-inline: auto; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item {
    border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 0.25rem 1.25rem; background: var(--surface-glass);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .faq-item[open] { border-color: var(--line-strong); background: rgba(255,255,255,0.05); box-shadow: var(--glow); }
  .faq-item summary {
    cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 600; font-size: 1.1rem;
    color: var(--ink); padding: 1rem 0; position: relative; padding-right: 2rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    font-size: 1.5rem; color: var(--brand); transition: transform 0.2s ease;
  }
  .faq-item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq-item p { margin: 0 0 1rem; color: var(--ink-2); }

  /* CTA */
  .cta-band h2 { margin-bottom: 0.75rem; }
  .cta-band .lead { margin-inline: auto; margin-bottom: 2rem; color: var(--ink-soft); }

  @media (max-width: 760px) {
    .founder { grid-template-columns: 1fr; }
    .founder-photo { max-width: 320px; }
    .hero { min-height: auto; }
  }
</style>
