---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import kostenImg from '../../assets/images/webdesign-kosten.jpg';

const steps = [
  { t: 'Kostenloses Erstgespräch', d: 'Wir lernen Ihr Unternehmen, Ihre Ziele und Ihre Zielgruppe kennen – unverbindlich und ehrlich.' },
  { t: 'Konzept & Entwurf', d: 'Sie sehen früh einen ersten Designentwurf und geben Feedback, bevor es in die Umsetzung geht.' },
  { t: 'Entwicklung', d: 'Wir setzen Ihre Seite pixelperfekt, schnell und für Suchmaschinen vorbereitet um – für alle Endgeräte.' },
  { t: 'Go-live', d: 'Nach Ihrer Freigabe geht die Webseite online. Auf Wunsch betreuen wir sie auch danach.' },
];

const included = [
  'Individuelles Webdesign – kein Baukasten',
  'Neuerstellung oder Redesign Ihrer Seite',
  'Responsive für Smartphone, Tablet & Desktop',
  'DSGVO-konforme Umsetzung',
  'Für Google vorbereitet (SEO-Standards)',
  'Einschulung in die Pflege Ihrer Seite',
];

const optional = [
  'Onlineshop',
  'Mehrsprachigkeit',
  'Texterstellung & Copywriting',
  'Professionelle Fotos & Imagefilm',
  'Laufende Wartung & Sicherheit',
  'Erweiterte SEO-Betreuung',
];

const packages = [
  { name: 'Basic', price: 'ab 1.899 €', pages: '5–10 Seiten', desc: 'Der solide Auftritt für Selbstständige und kleine Unternehmen.', features: ['Individuelles Design', 'Responsive & DSGVO', 'SEO-Grundlagen', 'Kontaktmöglichkeit'] },
  { name: 'Premium', price: 'ab 2.799 €', pages: '5–10 Seiten', desc: 'Mehr Umfang, mehr Wirkung – für anspruchsvolle Projekte.', features: ['Alles aus Basic', 'Erweiterte Funktionen', 'Animationen & Interaktion', 'Erweiterte SEO-Basis'], featured: true },
  { name: 'Shop', price: 'ab 4.999 €', pages: 'inkl. Onlineshop', desc: 'Verkaufen Sie online – mit einem Shop, der konvertiert.', features: ['Shop-Setup', 'Produkt- & Zahlungssystem', 'Versand & Steuern', 'Shop-SEO'] },
];

const weitere = [
  { t: 'Suchmaschinenoptimierung', d: 'Mehr Sichtbarkeit bei Google.', href: '/leistungen/seo/' },
  { t: 'WordPress Agentur', d: 'Betreuung & Erweiterung Ihrer Seite.', href: '/leistungen/wordpress-agentur/' },
  { t: 'SEO Consulting', d: 'Schulungen & Beratung für Ihr Team.', href: '/leistungen/seo-consultant/' },
];
---

<BaseLayout
  title="Optimierte Webseiten & Redesign » CodeRocker"
  description="Wir erstellen optimierte Webseiten und Redesigns, die Besucher zu Kunden machen – individuell, schnell, DSGVO-konform und zum transparenten Festpreis. Aus Hallein bei Salzburg."
  path="/leistungen/"
>
  <PageHero
    eyebrow="// leistungen"
    title='Optimierte Webseiten, die Besucher zu <span class="grad-text">Kunden</span> machen'
    lead="Ob komplett neu oder als Redesign Ihrer bestehenden Seite: Wir bauen Webseiten, die modern aussehen, schnell laden und mehr Anfragen bringen. Nach einem kostenlosen Erstgespräch erhalten Sie ein individuelles Festpreis-Angebot."
  >
    <div class="hero-actions">
      <button type="button" class="btn btn--grad" data-open-form data-magnetic>Projekt starten <span class="arrow">→</span></button>
    </div>
  </PageHero>

  <!-- PROZESS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>In 4 Schritten zu Ihrer neuen Webseite</h2>
        <p class="lead">Transparent von der ersten Idee bis zum Go-live – Sie wissen immer, woran wir gerade arbeiten.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" data-reveal data-tilt>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LEISTUNGEN -->
  <section class="section section--tint">
    <div class="container">
      <div class="grid grid--2 features">
        <div data-reveal="left">
          <h2>Immer dabei</h2>
          <ul class="check-list">{included.map((f) => <li>{f}</li>)}</ul>
        </div>
        <div data-reveal="right">
          <h2>Auf Wunsch</h2>
          <ul class="check-list check-list--plus">{optional.map((f) => <li>{f}</li>)}</ul>
        </div>
      </div>
      <p class="tech-note" data-reveal>Technisch setzen wir auf modernste, bewährte Systeme – für eine Seite, die Ihnen gehört und mit Ihnen wächst.</p>
    </div>
  </section>

  <!-- PREISE -->
  <section class="section">
    <div class="container">
      <div class="section-head section--center">
        <h2>Was kostet eine Website?</h2>
        <p class="lead">Jedes Projekt ist individuell – diese Pakete geben Orientierung. Den finalen Festpreis legen wir nach dem Erstgespräch fest.</p>
      </div>
      <div class="grid grid--3 price-grid">
        {packages.map((p) => (
          <div class:list={['price-card', { featured: p.featured }]} data-reveal data-tilt>
            {p.featured && <span class="badge">Beliebt</span>}
            <h3>{p.name}</h3>
            <p class="price">{p.price}</p>
            <p class="price-pages">{p.pages}</p>
            <p class="price-desc">{p.desc}</p>
            <ul class="check-list">{p.features.map((f) => <li>{f}</li>)}</ul>
            <button type="button" class:list={['btn', p.featured ? 'btn--grad' : 'btn--ghost']} data-open-form>Angebot anfragen</button>
          </div>
        ))}
      </div>
      <figure class="kosten-figure" data-reveal>
        <Image src={kostenImg} alt="Was kostet eine Website?" width={1200} height={675} quality={85} />
      </figure>
    </div>
  </section>

  <!-- WEITERE LEISTUNGEN -->
  <section class="section section--tint section--center">
    <div class="container">
      <div class="section-head">
        <h2>Brauchen Sie mehr?</h2>
        <p class="lead">Neben der Webseiten-Erstellung unterstützen wir Sie auch in diesen Bereichen.</p>
      </div>
      <div class="grid grid--3">
        {weitere.map((w) => (
          <a href={w.href} class="card weitere-card" data-reveal>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
            <span class="card-link">Mehr erfahren <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--ink section--center cta-band">
    <div class="container">
      <h2>Lassen Sie uns über Ihr Projekt sprechen</h2>
      <p class="lead">Erstgespräch kostenlos, Angebot zum Festpreis. Unkomplizierter geht's nicht.</p>
      <button type="button" class="btn btn--grad" data-open-form data-magnetic>Projekt starten <span class="arrow">→</span></button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions { margin-top: 2rem; }
  .cta-band .lead { margin-inline: auto; margin-bottom: 2rem; color: var(--ink-soft); }
  .cta-band h2 { margin-bottom: 0.75rem; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .step { background: var(--surface-glass); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.75rem; backdrop-filter: blur(10px); }
  .step-num { font-family: var(--font-mono); font-size: 1rem; font-weight: 500; color: #c4abff; }
  .step h3 { margin: 0.75rem 0 0.5rem; font-size: 1.2rem; }
  .step p { font-size: 0.95rem; margin: 0; }

  .features h2 { margin-bottom: 1.25rem; }
  .check-list { list-style: none; margin: 0; padding: 0; }
  .check-list li { position: relative; padding-left: 1.9rem; margin-bottom: 0.75rem; }
  .check-list li::before { content: '✓'; position: absolute; left: 0; top: 0; color: #fff; background: var(--grad); width: 1.3rem; height: 1.3rem; border-radius: 50%; display: grid; place-items: center; font-size: 0.8rem; }
  .check-list--plus li::before { content: '+'; }
  .tech-note { margin: 2.5rem 0 0; text-align: center; color: var(--ink-faint); font-size: 0.95rem; }

  .price-grid { align-items: stretch; }
  .price-card { position: relative; background: var(--surface-glass); border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem 1.75rem; display: flex; flex-direction: column; backdrop-filter: blur(10px); }
  .price-card.featured { border-color: var(--brand); box-shadow: var(--shadow-brand); }
  .badge { position: absolute; top: -0.75rem; left: 1.75rem; background: var(--grad); color: #fff; font-family: var(--font-mono); font-size: 0.75rem; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .price { font-family: var(--font-display); font-size: 2rem; font-weight: 800; color: #fff; margin: 0.5rem 0 0.25rem; }
  .price-pages { font-size: 0.85rem; color: var(--ink-faint); margin: 0 0 1rem; font-family: var(--font-mono); }
  .price-desc { font-size: 0.95rem; }
  .price-card .check-list { flex: 1; margin-bottom: 1.5rem; }
  .price-card .check-list li { font-size: 0.93rem; }
  .price-card .btn { width: 100%; justify-content: center; }

  .kosten-figure { margin: 3rem 0 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .kosten-figure :global(img) { width: 100%; height: auto; }

  .weitere-card { display: flex; flex-direction: column; color: var(--ink-2); text-decoration: none; text-align: left; }
  .weitere-card:hover { text-decoration: none; }
  .weitere-card h3 { margin-bottom: 0.4rem; }
  .weitere-card p { font-size: 0.95rem; flex: 1; }
  .card-link { font-family: var(--font-display); font-weight: 600; color: #c4abff; }

  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
