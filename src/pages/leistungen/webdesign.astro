---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import kostenImg from '../../assets/images/webdesign-kosten.jpg';

const steps = [
  { t: 'Kostenloses Erstgespräch', d: 'Wir lernen Ihr Unternehmen, Ihre Ziele und Ihre Zielgruppe kennen – unverbindlich und ehrlich.' },
  { t: 'Teilentwurf', d: 'Sie sehen früh einen ersten Designentwurf und geben Feedback, bevor es in die Umsetzung geht.' },
  { t: 'Entwicklung', d: 'Wir setzen die Seite pixelperfekt, schnell und SEO-optimiert um – für alle Endgeräte.' },
  { t: 'Go-live', d: 'Nach Ihrer Freigabe geht die Webseite online. Auf Wunsch betreuen wir sie auch danach.' },
];

const included = [
  'Modernes, individuelles Webdesign',
  'Responsive für Smartphone, Tablet & Desktop',
  'DSGVO-konforme Umsetzung',
  'SEO-Standards von Anfang an',
  'E-Mail-Postfächer einrichten',
  'Einschulung in die Pflege Ihrer Seite',
];

const optional = [
  'Onlineshop (WooCommerce)',
  'Mehrsprachigkeit',
  'Texterstellung & Copywriting',
  'Professionelle Fotos & Imagefilm',
  'Laufende Wartung & Sicherheit',
  'Erweiterte SEO-Betreuung',
];

const packages = [
  { name: 'Basic', price: 'ab 1.899 €', pages: '5–10 Seiten', desc: 'Der solide Auftritt für Selbstständige und kleine Unternehmen.', features: ['Individuelles Design', 'Responsive & DSGVO', 'SEO-Grundlagen', 'Kontaktformular'] },
  { name: 'Premium', price: 'ab 2.799 €', pages: '5–10 Seiten', desc: 'Mehr Umfang, mehr Wirkung – für anspruchsvolle Projekte.', features: ['Alles aus Basic', 'Erweiterte Funktionen', 'Animationen & Interaktion', 'Erweiterte SEO-Basis'], featured: true },
  { name: 'Shop', price: 'ab 4.999 €', pages: 'inkl. WooCommerce', desc: 'Verkaufen Sie online – mit einem Shop, der konvertiert.', features: ['Onlineshop-Setup', 'Produkt- & Zahlungssystem', 'Versand & Steuern', 'Shop-SEO'] },
];
---

<BaseLayout
  title="Webdesign » CodeRocker"
  description="Optimiertes Webdesign, das Besucher zu Kunden macht. Pixelperfekt, responsive, DSGVO-konform und SEO-optimiert – zum transparenten Festpreis. Agentur aus Hallein bei Salzburg."
  path="/leistungen/webdesign/"
>
  <PageHero
    eyebrow="// leistungen / webdesign"
    title='Optimiertes Webdesign, das Besucher zu <span class="grad-text">Kunden</span> konvertiert'
    lead="Gute Webseiten haben einen hohen Return on Investment. Deshalb bauen wir pixelperfekte Seiten – optimiert für alle Endgeräte, inklusive SEO. Nach einem kostenlosen Erstgespräch erhalten Sie ein individuelles Festpreis-Angebot."
  >
    <div class="hero-actions">
      <a href="/kontakt/" class="btn btn--grad">Kostenloses Erstgespräch <span class="arrow">→</span></a>
    </div>
  </PageHero>

  <!-- PROZESS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// ablauf</p>
        <h2>Unser 4-Schritte-Webdesign-Prozess</h2>
        <p class="lead">Transparent von der ersten Idee bis zum Go-live – Sie wissen immer, woran wir gerade arbeiten.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" data-reveal>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LEISTUNGEN -->
  <section class="section section--tint">
    <div class="container">
      <div class="grid grid--2 features">
        <div data-reveal>
          <p class="eyebrow">// inklusive</p>
          <h2>Inkludierte Leistungen</h2>
          <ul class="check-list">
            {included.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div data-reveal>
          <p class="eyebrow">// optional</p>
          <h2>Optionale Leistungen</h2>
          <ul class="check-list check-list--plus">
            {optional.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PREISE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// preise</p>
        <h2>Wie viel kostet eine Website?</h2>
        <p class="lead">Jedes Projekt ist individuell – diese Pakete geben Ihnen eine klare Orientierung. Den finalen Festpreis legen wir nach dem Erstgespräch fest.</p>
      </div>
      <div class="grid grid--3 price-grid">
        {packages.map((p) => (
          <div class:list={['price-card', { featured: p.featured }]} data-reveal>
            {p.featured && <span class="badge">Beliebt</span>}
            <h3>{p.name}</h3>
            <p class="price">{p.price}</p>
            <p class="price-pages">{p.pages}</p>
            <p class="price-desc">{p.desc}</p>
            <ul class="check-list">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a href="/kontakt/" class:list={['btn', p.featured ? 'btn--grad' : 'btn--ghost']}>Angebot anfragen</a>
          </div>
        ))}
      </div>
      <figure class="kosten-figure" data-reveal>
        <Image src={kostenImg} alt="Was kostet eine Website?" width={1000} height={563} />
      </figure>
    </div>
  </section>

  <section class="section section--ink section--center cta-band">
    <div class="container">
      <h2>Lassen Sie uns über Ihr Projekt sprechen</h2>
      <p class="lead">Erstgespräch kostenlos, Angebot zum Festpreis. Unkomplizierter geht's nicht.</p>
      <a href="/kontakt/" class="btn btn--grad">Projekt starten <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions { margin-top: 2rem; }
  .cta-band .lead { margin-inline: auto; margin-bottom: 2rem; color: var(--ink-soft); }
  .cta-band h2 { margin-bottom: 0.75rem; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .step { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.75rem; }
  .step-num { font-family: var(--font-mono); font-size: 1rem; font-weight: 500; color: var(--brand); }
  .step h3 { margin: 0.75rem 0 0.5rem; font-size: 1.2rem; }
  .step p { font-size: 0.95rem; margin: 0; }

  .features h2 { margin-bottom: 1.25rem; }
  .check-list { list-style: none; margin: 0; padding: 0; }
  .check-list li { position: relative; padding-left: 1.9rem; margin-bottom: 0.75rem; }
  .check-list li::before {
    content: '✓'; position: absolute; left: 0; top: 0;
    color: #fff; background: var(--grad); width: 1.3rem; height: 1.3rem;
    border-radius: 50%; display: grid; place-items: center; font-size: 0.8rem;
  }
  .check-list--plus li::before { content: '+'; }

  .price-grid { align-items: stretch; }
  .price-card {
    position: relative; background: #fff; border: 1px solid var(--line);
    border-radius: var(--radius); padding: 2rem 1.75rem; display: flex; flex-direction: column;
  }
  .price-card.featured { border-color: var(--brand); box-shadow: var(--shadow-brand); }
  .badge {
    position: absolute; top: -0.75rem; left: 1.75rem;
    background: var(--grad); color: #fff; font-family: var(--font-mono);
    font-size: 0.75rem; padding: 0.25rem 0.7rem; border-radius: 999px;
  }
  .price { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: var(--ink); margin: 0.5rem 0 0.25rem; }
  .price-pages { font-size: 0.85rem; color: #6a6690; margin: 0 0 1rem; font-family: var(--font-mono); }
  .price-desc { font-size: 0.95rem; }
  .price-card .check-list { flex: 1; margin-bottom: 1.5rem; }
  .price-card .check-list li { font-size: 0.93rem; }

  .kosten-figure { margin: 3rem 0 0; border-radius: var(--radius); overflow: hidden; }
  .kosten-figure :global(img) { width: 100%; height: auto; }

  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
