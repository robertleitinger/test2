---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { projekte } from '../../data/projekte';

export function getStaticPaths() {
  return projekte.map((p) => ({ params: { slug: p.slug }, props: { projekt: p } }));
}

const { projekt } = Astro.props;

// Bilder dynamisch auflösen (freigestelltes Mockup + Screenshot)
const mockups = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/projekte/*.png', { eager: true });
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/projekte/*.{jpg,png}', { eager: true });
const mockup = mockups[`../../assets/images/projekte/${projekt.slug}.png`]?.default;
const shotKey = `../../assets/images/projekte/${projekt.slug}-shot.${projekt.shotExt ?? 'jpg'}`;
const shot = shots[shotKey]?.default;

const host = projekt.url ? new URL(projekt.url).host.replace(/^www\./, '') : null;
const description = projekt.text[0];
---

<BaseLayout
  title={`${projekt.name} » Referenzen » CodeRocker`}
  description={description}
  path={`/referenzen/${projekt.slug}/`}
>
  <PageHero eyebrow={projekt.tag} title={projekt.name} />

  <section class="section">
    <div class="container">
      <div class="case-grid">
        {mockup && (
          <figure class="case-media" data-reveal>
            <Image src={mockup} alt={`${projekt.name} – Webdesign von CodeRocker`} width={1000} height={700} quality={86} />
          </figure>
        )}
        <div class="case-text" data-reveal>
          {projekt.text.map((p) => <p>{p}</p>)}
          {projekt.url && (
            <a class="btn btn--ghost case-visit" href={projekt.url} target="_blank" rel="noopener">
              {host} besuchen <span class="arrow" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>

      {shot && (
        <figure class="case-shot" data-reveal>
          <Image src={shot} alt={`Screenshot der Webseite ${projekt.name}`} width={1280} height={660} quality={82} />
        </figure>
      )}

      <p class="case-back" data-reveal><a href="/referenzen/">← Alle Referenzen ansehen</a></p>
    </div>
  </section>

  <section class="section section--ink section--center cta-band">
    <div class="container">
      <h2>Wird Ihr Projekt das nächste?</h2>
      <p class="lead">Erzählen Sie uns davon – wir freuen uns darauf, gemeinsam etwas Großartiges zu bauen.</p>
      <button type="button" class="btn btn--grad" data-open-form data-magnetic>Projekt starten <span class="arrow" aria-hidden="true">→</span></button>
    </div>
  </section>
</BaseLayout>

<style>
  .case-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .case-media { margin: 0; line-height: 0; }
  .case-media :global(img) {
    width: 100%; height: auto; display: block; object-fit: contain;
    filter: drop-shadow(0 26px 40px rgba(0, 0, 0, 0.55));
  }
  .case-text p { color: var(--ink-soft); margin: 0 0 1rem; }
  .case-visit { margin-top: 0.75rem; }
  .case-shot {
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0; line-height: 0;
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
  }
  .case-shot :global(img) { width: 100%; height: auto; display: block; }
  .case-back { margin-top: 2.5rem; }
  .case-back a { font-family: var(--font-display); font-weight: 600; color: #9b86ff; }
  .cta-band .lead { margin-inline: auto; margin-bottom: 2rem; color: var(--ink-soft); }
  .cta-band h2 { margin-bottom: 0.75rem; }
  @media (max-width: 820px) { .case-grid { grid-template-columns: 1fr; } }
</style>
