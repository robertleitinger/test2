---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Kontakt » CodeRocker"
  description="Starten Sie Ihre Projektanfrage bei CodeRocker. Erzählen Sie uns von Ihrem Webseiten-Projekt – das Erstgespräch ist kostenlos und unverbindlich."
  path="/kontakt/"
>
  <PageHero
    eyebrow="kontakt"
    title='Lassen Sie uns über Ihr <span class="grad-text">Projekt</span> sprechen'
    lead="Am einfachsten erreichen Sie uns über das Anfrageformular. Beschreiben Sie kurz Ihr Vorhaben – wir melden uns zeitnah mit den nächsten Schritten. Kostenlos und unverbindlich."
  >
    <div class="hero-actions">
      <button type="button" class="btn btn--grad" data-open-form data-magnetic>Projektanfrage starten <span class="arrow" aria-hidden="true">→</span></button>
    </div>
  </PageHero>

  <section class="section section--center">
    <div class="container contact-grid">
      <div class="contact-cta card" data-reveal data-tilt>
        <p class="kicker">schnellster weg</p>
        <h2>Projektanfrage</h2>
        <p>Erzählen Sie uns in wenigen Minuten von Ihrem Projekt – ganz bequem über unser Formular.</p>
        <button type="button" class="btn btn--grad" data-open-form data-magnetic>Jetzt Anfrage starten <span class="arrow" aria-hidden="true">→</span></button>
      </div>

      <div class="contact-info" data-reveal>
        <p class="kicker">erreichbarkeit</p>
        <h2>Direkt &amp; remote</h2>
        <p>
          Sie haben eine kurze Frage? Schreiben Sie uns:
        </p>
        <p><a class="contact-mail" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="contact-region">
          Wir betreuen Kunden im gesamten deutschsprachigen Raum – ortsunabhängig per
          Video-Call, Telefon und E-Mail. Persönliche Termine im Office gerne nach Vereinbarung.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions { margin-top: 2rem; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: stretch; text-align: left; max-width: 980px; margin-inline: auto; }
  .contact-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  .contact-cta h2, .contact-info h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 0.5rem; }
  .contact-cta p { color: var(--ink-soft); margin-bottom: 1.5rem; }
  .contact-cta .btn { margin-top: auto; }
  .contact-info { padding: 1.85rem 0; }
  .contact-mail { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
  .contact-region { color: var(--ink-soft); margin-top: 1rem; }
  @media (max-width: 760px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
