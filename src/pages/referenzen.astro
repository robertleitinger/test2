---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

import theEase from '../assets/images/ref/the-ease.png';
import chinWoo from '../assets/images/ref/chin-woo.png';
import robertLeitinger from '../assets/images/ref/robert-leitinger.png';
import kraftvoll from '../assets/images/ref/kraftvoll.png';
import adlerblick from '../assets/images/ref/adlerblick.png';
import physiotherapie from '../assets/images/ref/physiotherapie.png';
import veritec from '../assets/images/ref/veritec.png';
import drBuergel from '../assets/images/ref/dr-buergel.png';
import blickwinkel from '../assets/images/ref/99blickwinkel.png';
import micropart from '../assets/images/ref/micropart.png';
import podologie from '../assets/images/ref/podologie.png';
import lifestyyler from '../assets/images/ref/lifestyyler.png';

const projekte = [
  { img: theEase, name: 'THE EASE – Chiropraktik', tag: 'Onepager · Webdesign' },
  { img: chinWoo, name: 'Chin-Woo Energieoase', tag: 'Webdesign · Kung-Fu-Schule' },
  { img: veritec, name: 'Veritec Solution GmbH', tag: 'Webdesign · Elektrotechnik' },
  { img: adlerblick, name: 'Adlerblick Onlineshop', tag: 'Onlineshop · WooCommerce' },
  { img: physiotherapie, name: 'Physiotherapie Salzburg', tag: 'Webdesign · Praxis' },
  { img: drBuergel, name: 'Hausarzt Dr. Bürgel', tag: 'Webdesign · Arztpraxis' },
  { img: blickwinkel, name: '99blickwinkel', tag: 'Magazin · Webdesign' },
  { img: micropart, name: 'Micropart Onlineshop', tag: 'Onlineshop · WooCommerce' },
  { img: podologie, name: 'Podologie Kolb', tag: 'Webdesign · Praxis' },
  { img: kraftvoll, name: 'Kraftvoll & Sicher', tag: 'Webdesign · Coaching' },
  { img: lifestyyler, name: 'Lifestyle-Magazin', tag: 'Magazin · Webdesign' },
  { img: robertLeitinger, name: 'Robert Leitinger', tag: 'Personal Brand · SEO' },
];
---

<BaseLayout
  title="Referenzen & Projekte » CodeRocker"
  description="Spannende Projekte und glückliche Kunden ᐅ Unsere Referenzen und unser Webdesign-Portfolio aus der Region Salzburg und der gesamten DACH-Region."
  path="/referenzen/"
>
  <PageHero
    eyebrow="// referenzen"
    title='Großartige Projekte, großartige <span class="grad-text">Kunden</span>'
    lead="Ein Auszug aus unserem Portfolio: Webseiten und Onlineshops, die wir für Unternehmen aus den unterschiedlichsten Branchen umgesetzt haben."
  />

  <section class="section">
    <div class="container">
      <div class="ref-grid">
        {projekte.map((p) => (
          <figure class="ref-card" data-reveal data-tilt>
            <div class="ref-img">
              <Image src={p.img} alt={p.name} width={760} height={532} quality={82} />
            </div>
            <figcaption>
              <h3>{p.name}</h3>
              <p class="ref-tag">{p.tag}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink section--center cta-band">
    <div class="container">
      <h2>Wird Ihr Projekt das nächste?</h2>
      <p class="lead">Erzählen Sie uns davon – wir freuen uns darauf, gemeinsam etwas Großartiges zu bauen.</p>
      <a href="/kontakt/" class="btn btn--grad">Projekt starten <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .ref-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .ref-card {
    margin: 0; background: var(--surface-glass); border: 1px solid var(--line);
    border-radius: var(--radius); overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .ref-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: transparent; }
  .ref-img { overflow: hidden; aspect-ratio: 500 / 350; background: var(--paper-tint); }
  .ref-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .ref-card:hover .ref-img :global(img) { transform: scale(1.05); }
  .ref-card figcaption { padding: 1.25rem 1.4rem 1.5rem; }
  .ref-card h3 { font-size: 1.2rem; margin: 0 0 0.2rem; }
  .ref-tag { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-faint); margin: 0; }
  .cta-band .lead { margin-inline: auto; margin-bottom: 2rem; color: var(--ink-soft); }
  .cta-band h2 { margin-bottom: 0.75rem; }

  @media (max-width: 900px) { .ref-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ref-grid { grid-template-columns: 1fr; } }
</style>
