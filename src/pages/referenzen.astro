---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

import theEase from '../assets/images/ref/the-ease.png';
import chinWoo from '../assets/images/ref/chin-woo.png';
import kraftvoll from '../assets/images/ref/kraftvoll.png';
import physiotherapie from '../assets/images/ref/physiotherapie.png';
import veritec from '../assets/images/ref/veritec.png';
import drBuergel from '../assets/images/ref/dr-buergel.png';

const projekte = [
  { img: theEase, name: 'THE EASE – Chiropraktik', tag: 'Webdesign · Onepager' },
  { img: veritec, name: 'Veritec Solution GmbH', tag: 'Webdesign · Elektrotechnik' },
  { img: physiotherapie, name: 'Physiotherapie Salzburg', tag: 'Webdesign · Praxis' },
  { img: drBuergel, name: 'Hausarzt Dr. Bürgel', tag: 'Webdesign · Arztpraxis' },
  { img: chinWoo, name: 'Chin-Woo Energieoase', tag: 'Webdesign · Kung-Fu-Schule' },
  { img: kraftvoll, name: 'Kraftvoll & Sicher', tag: 'Webdesign · Coaching' },
];
---

<BaseLayout
  title="Referenzen & Projekte » CodeRocker"
  description="Spannende Projekte und glückliche Kunden ᐅ Ein Auszug aus unseren Referenzen und unserem Webdesign-Portfolio für Kunden im gesamten DACH-Raum."
  path="/referenzen/"
>
  <PageHero
    eyebrow="referenzen"
    title='Großartige Projekte, großartige <span class="grad-text">Kunden</span>'
    lead="Webseiten, die wir für Unternehmen aus den unterschiedlichsten Branchen umgesetzt haben – modern, schnell und auf Wirkung gebaut."
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="kicker">portfolio</p>
        <h2>Ein Auszug aus unseren Referenzen</h2>
      </div>
      <div class="ref-grid">
        {projekte.map((p) => (
          <figure class="ref-card" data-reveal data-tilt>
            <div class="ref-media">
              <Image src={p.img} alt={p.name} width={900} height={563} quality={84} />
            </div>
            <figcaption>
              <h3>{p.name}</h3>
              <p class="ref-tag">{p.tag}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink section--center cta-band">
    <div class="container">
      <h2>Wird Ihr Projekt das nächste?</h2>
      <p class="lead">Erzählen Sie uns davon – wir freuen uns darauf, gemeinsam etwas Großartiges zu bauen.</p>
      <button type="button" class="btn btn--grad" data-open-form data-magnetic>Projekt starten <span class="arrow">→</span></button>
    </div>
  </section>
</BaseLayout>

<style>
  .ref-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.25rem; }
  .ref-card {
    margin: 0; display: flex; flex-direction: column;
    background: linear-gradient(155deg, #242029 0%, #19161f 52%, #241c18 100%);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 2.6vw, 2.5rem);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .ref-card:hover {
    transform: translateY(-6px);
    border-color: var(--line-strong);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.85), var(--glow);
  }
  /* Mockup großzügig gepolstert eingerahmt */
  .ref-media {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--paper-tint);
    box-shadow: 0 28px 55px -24px rgba(0, 0, 0, 0.9);
  }
  .ref-media :global(img) {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center top;
    transition: transform 0.6s ease;
  }
  .ref-card:hover .ref-media :global(img) { transform: scale(1.04); }
  .ref-card figcaption { padding-top: 1.5rem; }
  .ref-card h3 { margin: 0 0 0.3rem; font-size: clamp(1.2rem, 2vw, 1.45rem); }
  .ref-tag { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.04em; color: #b3a4e0; margin: 0; }

  .cta-band .lead { margin-inline: auto; margin-bottom: 2rem; color: var(--ink-soft); }
  .cta-band h2 { margin-bottom: 0.75rem; }

  @media (max-width: 700px) { .ref-grid { grid-template-columns: 1fr; } }
</style>
