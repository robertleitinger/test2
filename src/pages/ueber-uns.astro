---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

import robert from '../assets/images/robert-about.jpg';
import andrea from '../assets/images/andrea.jpg';
import sebastian from '../assets/images/sebastian.jpg';
import mitarbeiter from '../assets/images/mitarbeiter.jpg';

import office1 from '../assets/images/office-1.jpg';
import office2 from '../assets/images/office-2.jpg';
import office3 from '../assets/images/office-3.jpg';
import office4 from '../assets/images/office-4.jpg';
import office5 from '../assets/images/office-5.jpg';

const team = [
  { img: robert, name: 'Robert', role: 'Marketing & SEO' },
  { img: andrea, name: 'Andrea', role: 'Organisation & Akquise' },
  { img: sebastian, name: 'Sebastian', role: 'Imagefilm' },
  { img: mitarbeiter, name: 'Du?', role: 'Jetzt bewerben' },
];

const office = [office1, office2, office3, office4, office5];
---

<BaseLayout
  title="Über uns » CodeRocker"
  description="Lernen Sie das Team, die Philosophie und die Vision von CodeRocker kennen – Ihrer Webdesign- und SEO-Agentur aus Hallein bei Salzburg."
  path="/ueber-uns/"
>
  <PageHero
    eyebrow="über uns"
    title='Wir lieben, was wir <span class="grad-text">tun</span>'
    lead="Wir haben es uns zur Aufgabe gemacht, Unternehmen mit gezielten Online-Marketing-Lösungen nach vorne zu bringen – ehrlich, respektvoll und langfristig."
  />

  <!-- PHILOSOPHIE -->
  <section class="section">
    <div class="container philo">
      <p class="kicker">unsere philosophie</p>
      <p class="philo-text">
        Wir lieben was wir tun und haben es uns zur Aufgabe gemacht, andere Unternehmen mit
        unseren gezielten Online-Marketing-Lösungen nach vorne zu bringen. Dabei ist uns vor allem
        ein guter Umgang und gegenseitiger Respekt wichtig – denn aus vielen Kundenprojekten
        entstehen langfristige Partnerschaften. Wir sehen uns deshalb weniger als einmaliger
        Dienstleister, sondern betreuen Kunden meist über einen langen Zeitraum.
      </p>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head section--center">
        <p class="kicker">das team</p>
        <h2>Die Menschen hinter CodeRocker</h2>
      </div>
      <div class="grid grid--4">
        {team.map((m) => (
          <div class:list={['team-card', { open: m.name === 'Du?' }]} data-reveal data-tilt>
            <div class="team-photo">
              <Image src={m.img} alt={m.name} width={560} height={700} quality={85} />
            </div>
            <h3>{m.name}</h3>
            <p class="team-role">{m.role}</p>
            {m.name === 'Du?' && <a href="/kontakt/" class="team-apply">Initiativ bewerben →</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OFFICE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="kicker">impressionen</p>
        <h2>Unser Office in Hallein</h2>
      </div>
      <div class="office-gallery">
        {office.map((o, i) => (
          <figure class:list={['office-item', { wide: i === 0 }]} data-reveal>
            <Image src={o} alt="Impression aus dem CodeRocker Office" width={820} height={547} quality={82} />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- REGION / KONTAKT -->
  <section class="section section--ink">
    <div class="container region-grid">
      <div data-reveal>
        <p class="kicker">einsatzgebiete</p>
        <h2>Vor Ort &amp; remote für Sie da</h2>
        <p class="lead">
          Wir setzen Projekte für Kunden in der gesamten DACH-Region um. Direkt vor Ort sind wir
          vor allem für Kunden in Österreich (Region Salzburg) sowie in Deutschland (Region Bayern)
          tätig. Ansonsten arbeiten wir remote – per Video-Call, Telefon und E-Mail.
        </p>
        <a href="/kontakt/" class="btn btn--grad" data-open-form>Kontakt aufnehmen <span class="arrow">→</span></a>
      </div>
      <address class="region-contact" data-reveal>
        <p class="kicker">kontakt</p>
        {site.street}<br />
        {site.postalCode} {site.city}, {site.country}<br /><br />
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <span class="muted">{site.hours}</span>
      </address>
    </div>
  </section>
</BaseLayout>

<style>
  .philo { max-width: 56rem; }
  .philo-text {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.4rem, 3vw, 2.1rem); line-height: 1.4; color: var(--ink);
    margin: 0;
  }

  .team-card { text-align: center; }
  .team-photo { border-radius: var(--radius); overflow: hidden; margin-bottom: 1rem; aspect-ratio: 4 / 5; }
  .team-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .team-card.open .team-photo { filter: grayscale(1); opacity: 0.7; }
  .team-card h3 { margin: 0; }
  .team-role { font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-faint); margin: 0.25rem 0 0; }
  .team-apply { display: inline-block; margin-top: 0.5rem; font-weight: 600; }

  .office-gallery {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
  }
  .office-item { margin: 0; border-radius: var(--radius-sm); overflow: hidden; aspect-ratio: 3 / 2; }
  .office-item.wide { grid-column: span 2; grid-row: span 2; }
  .office-item :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .region-grid { display: grid; grid-template-columns: 1.4fr 0.8fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .region-grid .lead { color: #fff; }
  .region-contact { font-style: normal; font-size: 1.05rem; line-height: 1.9; }
  .region-contact a { color: #fff; }
  .muted { color: var(--ink-faint); }

  @media (max-width: 820px) {
    .office-gallery { grid-template-columns: repeat(2, 1fr); }
    .office-item.wide { grid-column: span 2; grid-row: auto; }
    .region-grid { grid-template-columns: 1fr; }
  }
</style>
