---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Pfad mit führendem und abschließendem Slash, z. B. "/leistungen/" */
  path?: string;
  ogImage?: string;
  /** Dunkler Header über dunklem Hero? */
  heroDark?: boolean;
}

const {
  title,
  description,
  path = '/',
  ogImage = '/og-default.png',
  heroDark = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  image: ogImageUrl,
  priceRange: '€€',
  founder: { '@type': 'Person', name: site.owner },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.postalCode,
    addressLocality: site.city,
    addressCountry: 'AT',
  },
  openingHours: 'Mo-Fr 09:00-17:00',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '12',
  },
  areaServed: ['Salzburg', 'Hallein', 'Bayern', 'DACH'],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#5f34f0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="loader" id="loader" aria-hidden="true">
      <div class="loader__inner">
        <span class="loader__mark">CodeRocker</span>
        <span class="loader__bar"><i></i></span>
      </div>
    </div>
    <div class="cursor-ring" aria-hidden="true" transition:persist></div>
    <div class="cursor-dot" aria-hidden="true" transition:persist></div>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <canvas class="fx-shader" data-shader aria-hidden="true" transition:persist></canvas>
    <div class="fx-scrim" aria-hidden="true" transition:persist></div>
    <div class="fx-aurora" aria-hidden="true" transition:persist></div>
    <div class="fx-grain" aria-hidden="true" transition:persist></div>
    <div class="fx-spotlight" aria-hidden="true" transition:persist></div>
    <div class="scroll-progress" aria-hidden="true" transition:persist><span></span></div>
    <Header heroDark={heroDark} transition:persist="site-header" />
    <main id="main">
      <slot />
    </main>
    <Footer transition:persist="site-footer" />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = window.matchMedia('(pointer: fine)').matches;

      /* ============ PERSISTENTE FX (laufen einmal pro Session) ============ */
      function initPersistentFX() {
        if ((window as any).__crFX) return;
        (window as any).__crFX = true;

        // Scroll-Fortschritt
        const bar = document.querySelector<HTMLElement>('.scroll-progress > span');
        const onScroll = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          if (bar) bar.style.setProperty('--p', (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // Cursor-Spotlight
        const spot = document.querySelector<HTMLElement>('.fx-spotlight');
        if (spot && fine) {
          window.addEventListener('pointermove', (e) => {
            spot.style.setProperty('--mx', e.clientX + 'px');
            spot.style.setProperty('--my', e.clientY + 'px');
          }, { passive: true });
        }

        // Custom Cursor
        if (fine && !reduceMotion) {
          const dot = document.querySelector<HTMLElement>('.cursor-dot');
          const ring = document.querySelector<HTMLElement>('.cursor-ring');
          if (dot && ring) {
            document.body.classList.add('has-cursor');
            let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my, shown = false;
            window.addEventListener('pointermove', (e) => {
              mx = e.clientX; my = e.clientY;
              dot.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%)`;
              if (!shown) { shown = true; dot.style.opacity = '1'; ring.style.opacity = '1'; }
            }, { passive: true });
            const loop = () => {
              rx += (mx - rx) * 0.18; ry += (my - ry) * 0.18;
              ring.style.transform = `translate(${rx}px, ${ry}px) translate(-50%, -50%)`;
              requestAnimationFrame(loop);
            };
            requestAnimationFrame(loop);
            // Hover-Scale (Delegation, gilt auch nach Seitenwechsel)
            document.addEventListener('pointerover', (e) => {
              if ((e.target as Element).closest('a, button, [data-tilt], [data-magnetic], summary, input, textarea, select')) ring.classList.add('is-hover');
            });
            document.addEventListener('pointerout', (e) => {
              if ((e.target as Element).closest('a, button, [data-tilt], [data-magnetic], summary, input, textarea, select')) ring.classList.remove('is-hover');
            });
          }
        }

        // Site-weiter WebGL-Nebel-Shader
        const sc = document.querySelector<HTMLCanvasElement>('canvas.fx-shader');
        if (sc && !reduceMotion) {
          const gl = sc.getContext('webgl', { antialias: true });
          if (gl) {
            const vert = `attribute vec2 p; void main(){ gl_Position=vec4(p,0.0,1.0); }`;
            const frag = `
              precision highp float;
              uniform float u_t; uniform vec2 u_r; uniform vec2 u_m;
              vec2 hash(vec2 p){ p=vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))); return -1.0+2.0*fract(sin(p)*43758.5453123); }
              float noise(vec2 p){ vec2 i=floor(p),f=fract(p); vec2 u=f*f*(3.0-2.0*f);
                return mix(mix(dot(hash(i+vec2(0.0,0.0)),f-vec2(0.0,0.0)),dot(hash(i+vec2(1.0,0.0)),f-vec2(1.0,0.0)),u.x),
                           mix(dot(hash(i+vec2(0.0,1.0)),f-vec2(0.0,1.0)),dot(hash(i+vec2(1.0,1.0)),f-vec2(1.0,1.0)),u.x),u.y); }
              float fbm(vec2 p){ float v=0.0,a=0.5; for(int i=0;i<6;i++){ v+=a*noise(p); p*=2.0; a*=0.5; } return v; }
              void main(){
                vec2 uv=gl_FragCoord.xy/u_r.xy; vec2 p=uv; p.x*=u_r.x/u_r.y;
                float t=u_t*0.045;
                vec2 q=vec2(fbm(p+vec2(0.0,t)),fbm(p+vec2(5.2,1.3)-t));
                vec2 r=vec2(fbm(p+3.5*q+vec2(1.7,9.2)+0.15*t),fbm(p+3.5*q+vec2(8.3,2.8)-0.12*t));
                float n=fbm(p+3.5*r);
                float md=distance(uv,u_m); float glow=smoothstep(0.6,0.0,md)*0.28;
                vec3 c1=vec3(0.02,0.01,0.06);
                vec3 c2=vec3(0.30,0.16,0.80);
                vec3 c3=vec3(0.62,0.30,0.98);
                vec3 c4=vec3(0.24,0.80,0.78);
                vec3 col=mix(c1,c2,smoothstep(0.05,0.62,n+r.x*0.4));
                col=mix(col,c3,smoothstep(0.45,0.98,n*0.8+q.y*0.5));
                col+=c4*smoothstep(0.9,1.0,n)*0.4;
                col+=glow*c3;
                gl_FragColor=vec4(col,1.0);
              }`;
            const mk = (ty: number, s: string) => { const o = gl.createShader(ty)!; gl.shaderSource(o, s); gl.compileShader(o); return o; };
            const prog = gl.createProgram()!;
            gl.attachShader(prog, mk(gl.VERTEX_SHADER, vert));
            gl.attachShader(prog, mk(gl.FRAGMENT_SHADER, frag));
            gl.linkProgram(prog); gl.useProgram(prog);
            const b = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, b);
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
            const loc = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
            const uT = gl.getUniformLocation(prog, 'u_t'), uR = gl.getUniformLocation(prog, 'u_r'), uM = gl.getUniformLocation(prog, 'u_m');
            const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
            let mx = 0.5, my = 0.55, cx = 0.5, cy = 0.55;
            const resize = () => {
              sc.width = Math.max(1, Math.floor(innerWidth * dpr));
              sc.height = Math.max(1, Math.floor(innerHeight * dpr));
              gl.viewport(0, 0, sc.width, sc.height);
              gl.uniform2f(uR, sc.width, sc.height);
            };
            window.addEventListener('pointermove', (e) => { mx = e.clientX / innerWidth; my = 1 - e.clientY / innerHeight; }, { passive: true });
            window.addEventListener('resize', resize); resize();
            const start = performance.now();
            const draw = (now: number) => {
              cx += (mx - cx) * 0.04; cy += (my - cy) * 0.04;
              gl.uniform1f(uT, (now - start) / 1000);
              gl.uniform2f(uM, cx, cy);
              gl.drawArrays(gl.TRIANGLES, 0, 3);
              requestAnimationFrame(draw);
            };
            requestAnimationFrame(draw);
          }
        }
      }

      /* ============ SEITEN-FX (laufen bei jedem astro:page-load) ============ */
      function initPageFX() {
        // Scroll-Reveal
        const els = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (reduceMotion || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
          }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
          els.forEach((el) => io.observe(el));
        }

        // Parallax
        const px = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (px.length && !reduceMotion) {
          const onP = () => px.forEach((el) => {
            const r = el.getBoundingClientRect();
            const speed = parseFloat(el.dataset.parallax || '0.15');
            const off = (r.top + r.height / 2 - innerHeight / 2) * -speed;
            el.style.setProperty('--py', off.toFixed(1) + 'px');
          });
          onP();
          window.addEventListener('scroll', onP, { passive: true });
        }

        if (!reduceMotion && fine) {
          // 3D-Tilt
          document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
            if ((el as any).__tilt) return; (el as any).__tilt = true;
            const max = 9;
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              el.style.setProperty('--ry', (((e.clientX - r.left) / r.width - 0.5) * max).toFixed(2) + 'deg');
              el.style.setProperty('--rx', ((-((e.clientY - r.top) / r.height - 0.5)) * max).toFixed(2) + 'deg');
            });
            el.addEventListener('pointerleave', () => { el.style.setProperty('--rx', '0deg'); el.style.setProperty('--ry', '0deg'); });
          });
          // Magnetische Buttons
          document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
            if ((el as any).__mag) return; (el as any).__mag = true;
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              el.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.35}px, ${(e.clientY - r.top - r.height / 2) * 0.35}px)`;
            });
            el.addEventListener('pointerleave', () => { el.style.transform = ''; });
          });
        }

        // Count-up
        const counts = document.querySelectorAll<HTMLElement>('[data-count]');
        if (counts.length) {
          const run = (el: HTMLElement) => {
            const target = parseFloat(el.dataset.count || '0');
            const dec = parseInt(el.dataset.decimals || '0', 10);
            if (reduceMotion) { el.textContent = target.toFixed(dec); return; }
            const dur = 1400, s = performance.now();
            const step = (now: number) => {
              const t = Math.min((now - s) / dur, 1);
              el.textContent = (target * (1 - Math.pow(1 - t, 3))).toFixed(dec);
              if (t < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          };
          const io2 = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io2.unobserve(e.target); } }), { threshold: 0.5 });
          counts.forEach((c) => io2.observe(c));
        }

        // Hero-Partikel (nur wo vorhanden)
        const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-particles]');
        if (canvas && !reduceMotion && !(canvas as any).__init) {
          (canvas as any).__init = true;
          const ctx = canvas.getContext('2d')!;
          const hostEl = canvas.parentElement as HTMLElement;
          let w = 0, h = 0; const dpr = Math.min(window.devicePixelRatio || 1, 2);
          type P = { x: number; y: number; vx: number; vy: number };
          let pts: P[] = []; const m = { x: -9999, y: -9999 };
          const rs = () => {
            const r = hostEl.getBoundingClientRect(); w = r.width; h = r.height;
            canvas.width = w * dpr; canvas.height = h * dpr; canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            pts = Array.from({ length: Math.min(90, Math.floor(w * h / 15000)) }, () => ({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35 }));
          };
          const tick = () => {
            ctx.clearRect(0, 0, w, h);
            for (const p of pts) {
              p.x += p.vx; p.y += p.vy;
              if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1;
              const dx = m.x - p.x, dy = m.y - p.y, d2 = dx * dx + dy * dy;
              if (d2 < 26000) { p.vx += dx / d2 * 12; p.vy += dy / d2 * 12; }
              p.vx *= 0.99; p.vy *= 0.99;
            }
            for (let i = 0; i < pts.length; i++) for (let j = i + 1; j < pts.length; j++) {
              const a = pts[i], bb = pts[j], dx = a.x - bb.x, dy = a.y - bb.y, dist = Math.hypot(dx, dy);
              if (dist < 130) { ctx.strokeStyle = `rgba(150,110,255,${(1 - dist / 130) * 0.5})`; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(bb.x, bb.y); ctx.stroke(); }
            }
            for (const p of pts) { ctx.beginPath(); ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2); ctx.fillStyle = 'rgba(200,175,255,0.85)'; ctx.fill(); }
            raf = requestAnimationFrame(tick);
          };
          let raf = 0;
          hostEl.addEventListener('pointermove', (e) => { const r = hostEl.getBoundingClientRect(); m.x = e.clientX - r.left; m.y = e.clientY - r.top; });
          hostEl.addEventListener('pointerleave', () => { m.x = m.y = -9999; });
          window.addEventListener('resize', rs); rs();
          const io3 = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(tick); } else { cancelAnimationFrame(raf); raf = 0; } }));
          io3.observe(hostEl);
        }
      }

      // Intro-Loader: einmal pro Session
      function initLoader() {
        const loader = document.getElementById('loader');
        if (!loader) return;
        const finish = () => { loader.classList.add('done'); setTimeout(() => loader.remove(), 950); };
        if (reduceMotion || sessionStorage.getItem('cr_intro')) { loader.remove(); }
        else { sessionStorage.setItem('cr_intro', '1'); window.addEventListener('load', () => setTimeout(finish, 1100)); setTimeout(finish, 2600); }
      }

      const boot = () => { initPersistentFX(); initPageFX(); };
      initLoader();
      boot(); // initialer Load (Script liegt am Body-Ende → DOM ist da)
      // Nach View-Transition: neuer Seiteninhalt → Seiten-FX erneut initialisieren
      document.addEventListener('astro:after-swap', () => { initLoader(); boot(); });
    </script>
  </body>
</html>
