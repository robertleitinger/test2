---
import { Image } from 'astro:assets';
import logoWhite from '../assets/images/logo-white.png';
import { nav, site } from '../data/site';

interface Props {
  heroDark?: boolean;
}
const { heroDark = false } = Astro.props;
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-header" class:list={[{ 'is-dark': heroDark }]} data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} – Startseite`}>
      <Image src={logoWhite} alt={`${site.name} Logo`} width={150} height={34} class="brand-logo" />
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav-list">
        {nav.map((item) => (
          <li class:list={['nav-item', { 'has-children': item.children }]}>
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
              {item.label}
              {item.children && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {item.children && (
              <div class="dropdown">
                <ul>
                  {item.children.map((c) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href="/kontakt/" class="btn btn--grad header-cta">Projekt starten</a>

    <button class="burger" aria-label="Menü öffnen" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile-Panel -->
  <div class="mobile-panel" data-mobile hidden>
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
          {item.children && (
            <ul class="mobile-sub">
              {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
      <li><a class="btn btn--grad" href="/kontakt/">Projekt starten</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .site-header.is-dark {
    background: rgba(12, 10, 34, 0.55);
    border-bottom-color: var(--line-dark);
  }
  .site-header.is-dark .nav-link { color: #fff; }
  .site-header.is-dark .burger span { background: #fff; }
  /* Beim Scrollen wieder solide */
  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.92);
    border-bottom-color: var(--line);
  }
  .site-header.scrolled .nav-link { color: var(--ink-2); }
  .site-header.scrolled .burger span { background: var(--ink-2); }
  .site-header.scrolled .brand-logo { filter: invert(1) hue-rotate(180deg) brightness(0.9); }
  .is-dark:not(.scrolled) .brand-logo { filter: none; }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 72px;
  }
  .brand { display: inline-flex; align-items: center; line-height: 0; }
  .brand-logo { width: 150px; height: auto; }
  /* Logo ist weiß: auf hellem Header dunkel einfärben */
  .site-header:not(.is-dark) .brand-logo {
    filter: invert(1) hue-rotate(180deg) brightness(0.9);
  }

  .nav { margin-left: auto; }
  .nav-list { display: flex; gap: 0.35rem; list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.98rem;
    color: var(--ink-2);
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover { background: rgba(95, 52, 240, 0.08); color: var(--brand); }
  .nav-link.active { color: var(--brand); }
  .caret { font-size: 0.7em; opacity: 0.7; }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 230px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .has-children:hover .dropdown,
  .has-children:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .dropdown ul { list-style: none; margin: 0; padding: 0; }
  .dropdown a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }
  .dropdown a:hover { background: var(--paper-tint); color: var(--brand); }

  .header-cta { margin-left: 0.5rem; padding: 0.7rem 1.25rem; }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.4rem;
    margin-left: auto;
  }
  .burger span {
    width: 26px;
    height: 2px;
    background: var(--ink-2);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-panel {
    background: var(--ink);
    border-top: 1px solid var(--line-dark);
  }
  .mobile-panel ul { list-style: none; margin: 0; padding: 1rem var(--gutter) 2rem; }
  .mobile-panel > ul > li { padding: 0.25rem 0; }
  .mobile-panel a {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1rem;
    padding: 0.6rem 0;
    text-decoration: none;
  }
  .mobile-sub { padding: 0 0 0.5rem 1rem !important; }
  .mobile-sub a { font-size: 0.98rem; color: var(--ink-soft); font-weight: 400; }
  .mobile-panel .btn { margin-top: 1rem; color: #fff; }

  @media (max-width: 900px) {
    .nav, .header-cta { display: none; }
    .burger { display: flex; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const burger = document.querySelector('[data-burger]');
  const panel = document.querySelector('[data-mobile]') as HTMLElement | null;

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
    if (panel) panel.hidden = open;
  });

  // Header wird beim Scrollen solide
  const onScroll = () => {
    if (window.scrollY > 24) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
